From ca1e5aaa079cd8a23e1471524ddbbdef16abce1f Mon Sep 17 00:00:00 2001
From: vivy <vivy@aosp-builder>
Date: Sun, 8 Nov 2026 14:02:45 +0500
Subject: [PATCH] facebeauty: probe /system_ext (not /product) for ProductJni

The guarded libApsFaceBeautyPreviewProductJni.so ships at
/system_ext/lib64 on our tree (my_product -> system_ext remap), so the
<clinit> /product/lib64 probe fails -> unguarded in-APK fallback ->
all-zero FaceBeautyParams -> lib2DSlender adjustParam+836 SIGSEGV.
Point the probe at where the guarded lib actually is.

---
 smali/com/oplus/camera/facebeauty/OplusFaceBeautyPreview.smali | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/smali/com/oplus/camera/facebeauty/OplusFaceBeautyPreview.smali b/smali/com/oplus/camera/facebeauty/OplusFaceBeautyPreview.smali
index f49f8eb..286c984 100644
--- a/smali/com/oplus/camera/facebeauty/OplusFaceBeautyPreview.smali
+++ b/smali/com/oplus/camera/facebeauty/OplusFaceBeautyPreview.smali
@@ -16,7 +16,7 @@
 
     const-string v2, "ApsFaceBeautyPreviewProductJni"
 
-    const-string v3, "/product/lib64/libApsFaceBeautyPreviewProductJni.so"
+    const-string v3, "/system_ext/lib64/libApsFaceBeautyPreviewProductJni.so"
 
     if-eqz v0, :cond_2
 
